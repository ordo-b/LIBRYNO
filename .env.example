# ============================================
# LIBRYNO v2.0 - Variáveis de Ambiente
# ============================================

# --- OrdoB Core API ---
ORDOB_API_URL=https://api.ordob.com/api
ORDOB_API_URL_DEV=http://localhost:8000/api
ORDOB_PRODUCT_SLUG=libryno
ORDOB_ENV=production

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=libryno://auth/callback

# --- Banco de Dados ---
DATABASE_URL=sqlite:///data/libryno.db

# --- App ---
APP_VERSION=2.0.0
APP_DEBUG=false
APP_LOCALE=pt_BR
APP_THEME=auto

# --- Sync ---
SYNC_ENABLED=true
SYNC_INTERVAL=300

# --- Segurança ---
SECRET_KEY=
