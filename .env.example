# ============================================
# LIBRYNO v2.0 - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# --- OrdoB Core API ---
ORDOB_API_URL=https://api.ordob.com/api
ORDOB_API_URL_DEV=http://localhost:8000/api
ORDOB_PRODUCT_SLUG=libryno
ORDOB_ENV=production

# --- Banco de Dados ---
DATABASE_URL=sqlite:///data/libryno.db

# --- App ---
APP_VERSION=2.0.0
APP_DEBUG=false
APP_LOCALE=pt_BR
APP_THEME=dark

# --- Segurança ---
# Deixe vazio para gerar automaticamente na primeira execução
SECRET_KEY=
