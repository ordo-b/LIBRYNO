<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= appName %> — Gestão de Biblioteca Inteligente</title>
  <meta name="description" content="LIBRYNO - Sistema completo e gratuito para gestão de bibliotecas públicas. Controle livros, leitores e empréstimos com inteligência.">
  <link rel="icon" href="/img/icon.png" type="image/png">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Particle Canvas -->
  <canvas id="particles"></canvas>

  <!-- Cursor Glow -->
  <div id="cursor-glow"></div>

  <!-- Navbar -->
  <nav class="navbar" id="navbar">
    <div class="container nav-container">
      <a href="#" class="logo">
        <div class="logo-icon-wrap">
          <span class="logo-icon">📚</span>
          <div class="logo-pulse"></div>
        </div>
        <div class="logo-text-wrap">
          <span class="logo-text"><%= appName %></span>
          <span class="logo-version">v<%= version %></span>
        </div>
      </a>
      <div class="nav-links" id="navLinks">
        <a href="#features" class="nav-link">Funcionalidades</a>
        <a href="#premium" class="nav-link">Premium</a>
        <a href="#import" class="nav-link">Importação</a>
        <a href="#about" class="nav-link">Sobre</a>
        <a href="#download" class="btn-nav-glow">Baixar Grátis</a>
      </div>
      <button class="mobile-menu" id="mobileMenu" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero" id="hero">
    <div class="hero-bg">
      <div class="gradient-orb orb-1"></div>
      <div class="gradient-orb orb-2"></div>
      <div class="gradient-orb orb-3"></div>
      <div class="grid-overlay"></div>
    </div>
    <div class="container hero-content">
      <div class="hero-text">
        <div class="hero-badge reveal" data-delay="0">
          <span class="badge-dot"></span>
          Versão <%= version %> • Open Source • Gratuito
        </div>
        <h1 class="hero-title reveal" data-delay="100">
          Gerencie sua biblioteca<br>
          com <span class="text-gradient">inteligência</span>
        </h1>
        <p class="hero-desc reveal" data-delay="200">
          <%= appName %> é o sistema completo para gestão de bibliotecas públicas.
          Controle livros, leitores, empréstimos e gere relatórios — tudo em um só lugar, de graça.
        </p>
        <div class="hero-actions reveal" data-delay="300">
          <a href="#download" class="btn btn-primary btn-glow btn-lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Baixar Agora
          </a>
          <a href="#features" class="btn btn-glass btn-lg">
            Ver Funcionalidades
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="hero-stats reveal" data-delay="400">
          <div class="stat-item">
            <span class="stat-number" data-target="1247">0</span>
            <span class="stat-label">Livros Gerenciados</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number" data-target="389">0</span>
            <span class="stat-label">Leitores Ativos</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number" data-target="56">0</span>
            <span class="stat-label">Empréstimos Hoje</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number">100<span class="stat-suffix">%</span></span>
            <span class="stat-label">Gratuito</span>
          </div>
        </div>
      </div>
      <div class="hero-visual reveal" data-delay="200">
        <div class="app-mockup">
          <div class="mockup-header">
            <div class="mockup-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="mockup-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
              LIBRYNO Dashboard
            </div>
            <div class="mockup-actions">
              <span class="mockup-minimize">—</span>
              <span class="mockup-maximize">□</span>
              <span class="mockup-close">×</span>
            </div>
          </div>
          <div class="mockup-body">
            <div class="mockup-sidebar">
              <div class="sidebar-item active">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                Dashboard
              </div>
              <div class="sidebar-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
                Biblioteca
              </div>
              <div class="sidebar-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
                Leitores
              </div>
              <div class="sidebar-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Empréstimos
              </div>
              <div class="sidebar-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
                Config
              </div>
            </div>
            <div class="mockup-main">
              <div class="mockup-cards">
                <div class="mini-card">
                  <div class="mini-card-icon" style="background: rgba(92,225,230,0.15); color: #5CE1E6;">📚</div>
                  <div class="mini-card-info">
                    <span class="mini-card-num counter" data-target="1247">0</span>
                    <span class="mini-card-label">Livros</span>
                  </div>
                </div>
                <div class="mini-card">
                  <div class="mini-card-icon" style="background: rgba(255,215,0,0.15); color: #FFD700;">👥</div>
                  <div class="mini-card-info">
                    <span class="mini-card-num counter" data-target="389">0</span>
                    <span class="mini-card-label">Leitores</span>
                  </div>
                </div>
                <div class="mini-card">
                  <div class="mini-card-icon" style="background: rgba(46,204,113,0.15); color: #2ecc71;">📖</div>
                  <div class="mini-card-info">
                    <span class="mini-card-num counter" data-target="56">0</span>
                    <span class="mini-card-label">Ativos</span>
                  </div>
                </div>
              </div>
              <div class="mockup-chart">
                <div class="chart-bars">
                  <div class="chart-bar" style="--h: 65%"><span>Jan</span></div>
                  <div class="chart-bar" style="--h: 45%"><span>Fev</span></div>
                  <div class="chart-bar" style="--h: 80%"><span>Mar</span></div>
                  <div class="chart-bar" style="--h: 35%"><span>Abr</span></div>
                  <div class="chart-bar" style="--h: 70%"><span>Mai</span></div>
                  <div class="chart-bar" style="--h: 55%"><span>Jun</span></div>
                  <div class="chart-bar" style="--h: 90%"><span>Jul</span></div>
                </div>
              </div>
            </div>
          </div>
          <div class="mockup-glow"></div>
        </div>
      </div>
    </div>
    <div class="hero-scroll-indicator">
      <div class="scroll-mouse">
        <div class="scroll-wheel"></div>
      </div>
      <span>Scroll para explorar</span>
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="tech-stack">
    <div class="container">
      <div class="tech-marquee">
        <div class="tech-track">
          <div class="tech-item"><span class="tech-dot"></span>PyQt5</div>
          <div class="tech-item"><span class="tech-dot"></span>SQLite</div>
          <div class="tech-item"><span class="tech-dot"></span>Python</div>
          <div class="tech-item"><span class="tech-dot"></span>OrdoB Core</div>
          <div class="tech-item"><span class="tech-dot"></span>Matplotlib</div>
          <div class="tech-item"><span class="tech-dot"></span>ReportLab</div>
          <div class="tech-item"><span class="tech-dot"></span>Pandas</div>
          <div class="tech-item"><span class="tech-dot"></span>bcrypt</div>
          <div class="tech-item"><span class="tech-dot"></span>PyQt5</div>
          <div class="tech-item"><span class="tech-dot"></span>SQLite</div>
          <div class="tech-item"><span class="tech-dot"></span>Python</div>
          <div class="tech-item"><span class="tech-dot"></span>OrdoB Core</div>
          <div class="tech-item"><span class="tech-dot"></span>Matplotlib</div>
          <div class="tech-item"><span class="tech-dot"></span>ReportLab</div>
          <div class="tech-item"><span class="tech-dot"></span>Pandas</div>
          <div class="tech-item"><span class="tech-dot"></span>bcrypt</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features" id="features">
    <div class="container">
      <div class="section-header reveal">
        <div class="section-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Funcionalidades
        </div>
        <h2 class="section-title">Tudo que sua biblioteca<br><span class="text-gradient">precisa</span></h2>
        <p class="section-desc">Um sistema completo, rápido e seguro para gerenciar todos os aspectos da sua biblioteca pública.</p>
      </div>

      <div class="features-grid">
        <div class="feature-card reveal" data-delay="0">
          <div class="feature-icon-wrap">
            <div class="feature-icon">📚</div>
            <div class="feature-icon-ring"></div>
          </div>
          <h3>Gestão de Livros</h3>
          <p>Cadastro completo com ISBN, editora, classificação, capa e sinopse. Busca automática via BrasilAPI.</p>
          <div class="feature-tag">Core</div>
        </div>
        <div class="feature-card reveal" data-delay="100">
          <div class="feature-icon-wrap">
            <div class="feature-icon">👥</div>
            <div class="feature-icon-ring"></div>
          </div>
          <h3>Controle de Leitores</h3>
          <p>Cadastro com validação de CPF, telefone, escolaridade e endereço. Máscaras de entrada inteligentes.</p>
          <div class="feature-tag">Core</div>
        </div>
        <div class="feature-card reveal" data-delay="200">
          <div class="feature-icon-wrap">
            <div class="feature-icon">📊</div>
            <div class="feature-icon-ring"></div>
          </div>
          <h3>Dashboard Analítico</h3>
          <p>Gráficos interativos de pizza, barras e linha. Visão completa em tempo real dos seus dados.</p>
          <div class="feature-tag">Core</div>
        </div>
        <div class="feature-card reveal" data-delay="300">
          <div class="feature-icon-wrap">
            <div class="feature-icon">🔍</div>
            <div class="feature-icon-ring"></div>
          </div>
          <h3>Busca Global</h3>
          <p>Pesquisa inteligente que cruza livros e leitores em múltiplos campos simultaneamente.</p>
          <div class="feature-tag">Core</div>
        </div>
        <div class="feature-card reveal" data-delay="400">
          <div class="feature-icon-wrap">
            <div class="feature-icon">📥</div>
            <div class="feature-icon-ring"></div>
          </div>
          <h3>Importar Planilhas</h3>
          <p>Importe dados de Excel (.xlsx) e CSV diretamente. Mapeamento automático de colunas.</p>
          <div class="feature-tag premium-tag">Premium</div>
        </div>
        <div class="feature-card reveal" data-delay="500">
          <div class="feature-icon-wrap">
            <div class="feature-icon">📄</div>
            <div class="feature-icon-ring"></div>
          </div>
          <h3>Relatórios PDF</h3>
          <p>Gere relatórios profissionais de livros, leitores e empréstimos em PDF formatado.</p>
          <div class="feature-tag premium-tag">Premium</div>
        </div>
        <div class="feature-card reveal" data-delay="600">
          <div class="feature-icon-wrap">
            <div class="feature-icon">🎨</div>
            <div class="feature-icon-ring"></div>
          </div>
          <h3>Temas Personalizáveis</h3>
          <p>Escolha entre temas Dark e Light. Interface moderna, acessível e ergonômica.</p>
          <div class="feature-tag">Core</div>
        </div>
        <div class="feature-card reveal" data-delay="700">
          <div class="feature-icon-wrap">
            <div class="feature-icon">🌐</div>
            <div class="feature-icon-ring"></div>
          </div>
          <h3>Bilíngue</h3>
          <p>Suporte a Português BR e Inglês. Interface traduzida instantaneamente.</p>
          <div class="feature-tag">Core</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Premium / Pricing -->
  <section class="premium" id="premium">
    <div class="premium-bg">
      <div class="gradient-orb orb-gold-1"></div>
      <div class="gradient-orb orb-gold-2"></div>
    </div>
    <div class="container">
      <div class="section-header reveal">
        <div class="section-badge gold-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Premium
        </div>
        <h2 class="section-title">Desbloqueie todo o<br><span class="text-gradient-gold">potencial</span></h2>
        <p class="section-desc">Ative o tier Premium com uma chave OrdoB e tenha acesso a recursos avançados.</p>
      </div>

      <div class="pricing-grid">
        <!-- Free -->
        <div class="pricing-card reveal" data-delay="0">
          <div class="pricing-ribbon">GRATUITO</div>
          <div class="pricing-header">
            <div class="pricing-icon">📖</div>
            <h3>Free</h3>
            <div class="pricing-price">
              <span class="price-currency">R$</span>
              <span class="price-amount">0</span>
              <span class="price-period">para sempre</span>
            </div>
          </div>
          <ul class="pricing-features">
            <li><span class="check">✓</span> CRUD de Livros</li>
            <li><span class="check">✓</span> CRUD de Leitores</li>
            <li><span class="check">✓</span> CRUD de Colaboradores</li>
            <li><span class="check">✓</span> Dashboard com Gráficos</li>
            <li><span class="check">✓</span> Busca Global</li>
            <li><span class="check">✓</span> Exportação Excel</li>
            <li><span class="check">✓</span> Consulta ISBN</li>
            <li><span class="check">✓</span> Tema Dark</li>
            <li class="disabled"><span class="cross">✗</span> Empréstimos</li>
            <li class="disabled"><span class="cross">✗</span> Relatórios PDF</li>
            <li class="disabled"><span class="cross">✗</span> Importar Planilhas</li>
            <li class="disabled"><span class="cross">✗</span> Backup Automático</li>
          </ul>
          <a href="#download" class="btn btn-glass btn-block">Baixar Free</a>
        </div>

        <!-- Premium -->
        <div class="pricing-card featured reveal" data-delay="200">
          <div class="pricing-ribbon gold">⭐ PREMIUM</div>
          <div class="pricing-header">
            <div class="pricing-icon gold-icon">👑</div>
            <h3>Premium</h3>
            <div class="pricing-price">
              <span class="price-currency">R$</span>
              <span class="price-amount gold-amount">19,90</span>
              <span class="price-period">/mês</span>
            </div>
          </div>
          <ul class="pricing-features">
            <li><span class="check gold-check">✓</span> Tudo do Free</li>
            <li><span class="check gold-check">✓</span> Empréstimos + Multas</li>
            <li><span class="check gold-check">✓</span> Relatórios PDF</li>
            <li><span class="check gold-check">✓</span> Importar Planilhas</li>
            <li><span class="check gold-check">✓</span> Backup Automático</li>
            <li><span class="check gold-check">✓</span> Notificações</li>
            <li><span class="check gold-check">✓</span> Multi-usuário</li>
            <li><span class="check gold-check">✓</span> Catalogação com Tags</li>
            <li><span class="check gold-check">✓</span> 5+ Temas</li>
            <li><span class="check gold-check">✓</span> Sem Anúncios</li>
            <li><span class="check gold-check">✓</span> Suporte Prioritário</li>
            <li><span class="check gold-check">✓</span> Atualizações Premium</li>
          </ul>
          <a href="#download" class="btn btn-gold btn-block btn-glow-gold">Ativar Premium</a>
          <div class="pricing-badge-glow"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Import Feature -->
  <section class="import-section" id="import">
    <div class="container">
      <div class="import-grid">
        <div class="import-content reveal">
          <div class="section-badge gold-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Premium Feature
          </div>
          <h2 class="section-title">Importe dados<br>de <span class="text-gradient-gold">planilhas</span></h2>
          <p class="section-desc" style="text-align: left;">Já tem seus dados em Excel? O LIBRYNO importa automaticamente com mapeamento inteligente de colunas.</p>
          <ul class="import-features">
            <li>
              <div class="import-feature-icon">📊</div>
              <div>
                <strong>Suporte Universal</strong>
                <span>.xlsx, .xls e .csv</span>
              </div>
            </li>
            <li>
              <div class="import-feature-icon">🔄</div>
              <div>
                <strong>Mapeamento Automático</strong>
                <span>Colunas detectadas automaticamente</span>
              </div>
            </li>
            <li>
              <div class="import-feature-icon">✅</div>
              <div>
                <strong>Validação Inteligente</strong>
                <span>Dados verificados antes da importação</span>
              </div>
            </li>
            <li>
              <div class="import-feature-icon">📈</div>
              <div>
                <strong>Lote Ilimitado</strong>
                <span>Milhares de registros de uma vez</span>
              </div>
            </li>
            <li>
              <div class="import-feature-icon">🚫</div>
              <div>
                <strong>Duplicatas Protegidas</strong>
                <span>Registros repetidos são detectados</span>
              </div>
            </li>
          </ul>
          <a href="#download" class="btn btn-gold btn-lg">
            Ativar Premium
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="import-visual reveal" data-delay="200">
          <div class="import-demo">
            <div class="import-flow">
              <div class="import-file">
                <div class="file-icon">📄</div>
                <span>planilha.xlsx</span>
                <div class="file-size">2.4 KB</div>
              </div>
              <div class="import-arrow-anim">
                <div class="arrow-line"></div>
                <div class="arrow-dots">
                  <span></span><span></span><span></span>
                </div>
              </div>
              <div class="import-target">
                <div class="file-icon target-icon">📚</div>
                <span>LIBRYNO</span>
